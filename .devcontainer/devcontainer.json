{
	"name": "Labo Environment",

	// Dockerfileから直接ビルドする設定
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},

	// ワークスペースのマウント設定
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",

	// コンテナ内で有効にするVS Codeの拡張機能
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",

				"ms-toolsai.jupyter",
				"ms-toolsai.jupyter-keymap",
				"ms-toolsai.jupyter-renderers",
				"ms-toolsai.vscode-jupyter-cell-tags",

				"google.geminicodeassist",

				"oderwat.indent-rainbow",
				"me-ceintl.vscode-language-pack-ja"
			]
		}
	},

	// コンテナ作成後に実行するコマンド (インストール確認)
	"postCreateCommand": "python -c \"from rdkit import Chem; from tdc.single_pred import ADME; print('RDKit and PyTDC are successfully installed!')\""
}