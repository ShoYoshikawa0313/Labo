{
	"name": "Python (RDKit, PyTDC)",

	// Dockerfileから直接ビルドする設定
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},

	// ワークスペースのマウント設定
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",

	// コンテナ内で有効にするVS Codeの拡張機能
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"mechatroner.rainbow-csv",
                "ms-azuretools.vscode-docker",
				"ms-azuretools.vscode-containers",
				"janoschmenke.smiles-visualization"
			]
		}
	},

	// コンテナ作成後に実行するコマンド (インストール確認)
	"postCreateCommand": "python -c \"from rdkit import Chem; from tdc.single_pred import ADME; print('RDKit and PyTDC are successfully installed!')\""
}
